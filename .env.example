# Copy to .env and fill in the secrets. Never commit .env.

# Database (Rust backend only — the agent never touches the database, see ADR-006)
# Port 5433 on the host (the compose postgres maps 5433->5432 to avoid clashing
# with a locally installed PostgreSQL).
DATABASE_URL=postgres://app:app@localhost:5433/aiagent

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# Shared token for internal calls: Rust <-> FastAPI <-> worker (ADR-005/006)
INTERNAL_API_TOKEN=change-me
# Jobs stuck in pending/running longer than this are failed by the backend reaper (ADR-016).
JOB_TIMEOUT_MINUTES=15
# Cadence of the backend background loop: reaper + recurring-search scheduler (ADR-033).
SCHEDULER_TICK_SECONDS=60
# Abuse protection (ADR-017): per-user searches per rolling 24h, per-IP requests per minute.
DAILY_SEARCH_QUOTA=20
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
# Distributed rate limiting (ADR-037, opt-in): set when running several
# backend replicas, e.g. redis://localhost:6379/1. Empty = in-memory limiter.
RATE_LIMIT_REDIS_URL=

# JWT signing secret (ADR-008)
JWT_SECRET=change-me
# Refresh token lifetime (ADR-008); tokens are rotated on every /refresh.
REFRESH_TOKEN_DAYS=30

# LLM + search providers (ADR-009/010)
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
AGENT_MODEL_ID=claude-opus-4-8
# "live" (Tavily + Claude, keys required) or "fake" (deterministic keyless
# providers — e2e tests and local development without API keys, ADR-021).
AGENT_PROVIDERS=live
# LLM backend behind the live adapters (ADR-041): "anthropic" (hosted API,
# needs ANTHROPIC_API_KEY) or "ollama" (a model running locally, no key —
# AGENT_MODEL_ID then names the local model, e.g. "qwen3:14b", and the cost
# rates below should be set to 0). From a compose container, the host's
# Ollama is reached at http://host.docker.internal:11434.
AGENT_LLM_BACKEND=anthropic
AGENT_LLM_BASE_URL=http://localhost:11434
# Per-call hardening (ADR-044): bound each LLM call so a hung or flaky provider
# does not stall the worker. Raise the timeout if a cold local model (loading
# a large model into VRAM) needs longer on its first call. Retries apply to
# the Anthropic backend only; Ollama falls back to the Celery task retry.
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_LLM_MAX_RETRIES=2
# Spend tracking (ADR-038): indicative USD rates used to price each run.
# Defaults match Claude Opus 4.x ($5/$25 per MTok) and Tavily basic search
# ($0.008/call) at the time of writing — adjust to your model and plan.
LLM_COST_INPUT_PER_MTOK=5.0
LLM_COST_OUTPUT_PER_MTOK=25.0
SEARCH_COST_PER_CALL=0.008
# Step budget of the agent mode's decision loop (ADR-030) — the cost guard:
# each step is at most one policy LLM call plus one provider search.
AGENT_MAX_STEPS=5
# Logging (ADR-018): pretty for dev, json in production (one JSON object per line).
LOG_FORMAT=pretty
# Traces (ADR-029, opt-in): empty = disabled. Point at an OTLP collector to
# enable, e.g. http://localhost:4318 with the compose observability profile
# (Jaeger UI on http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=
# ADR-020: `production` turns missing/placeholder required variables into a
# startup failure (set by docker-compose.prod.yml; leave as development locally).
APP_ENV=development

# Service URLs
AGENT_API_URL=http://localhost:8001          # FastAPI micro-API as seen by the Rust backend
BACKEND_INTERNAL_URL=http://localhost:8000   # Rust API as seen by the Celery worker
